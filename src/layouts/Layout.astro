---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  isHome?: boolean;
}

const {
  title = 'KOUNS — Turn insight into impact. Build what’s next.',
  description = 'KOUNS is a premier strategic advisory practice uniting Branding, Strategy, Business Development, and Data & Insights to build compounding commercial value for ambitious enterprises.',
  isHome = false,
} = Astro.props;

const kouns = (path: string) => `/assets/kouns/${path}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600&display=swap" rel="stylesheet" />
    <link rel="icon" href={kouns('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate icon" href={kouns('logo-symbol-dark.png')} type="image/png" />
    <title>{title}</title>
  </head>
  <body>
    <div class="roofguard-page">
      <Header isHome={isHome} />
      
      <slot />

      <Footer isHome={isHome} />
    </div>

    <script>
      import { initSmoothExperience } from '../scripts/smoothScroll';

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSmoothExperience);
      } else {
        initSmoothExperience();
      }
    </script>
  </body>
</html>

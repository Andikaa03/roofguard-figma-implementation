    icon: 'imgArrowUpRight03.svg',
    signals: ['Customer Acquisition', 'Revenue Channels', 'Growth Levers']
  },
  {
    step: '03',
    stage: 'Transforming',
    subtitle: 'Pivot & Evolution',
    desc: 'Repositioning their brand, evolving their business model or navigating strategic market shifts.',
    icon: 'imgCertificate01.svg',
    signals: ['Brand Evolution', 'Model Redesign', 'Market Re-entry']
  },
  {
    step: '04',
    stage: 'Expanding',
    subtitle: 'New Markets & Verticals',
    desc: 'Entering new geographical territories or exploring adjacent market opportunities.',
    icon: 'imgLocation05.svg',
    signals: ['Regional Expansion', 'Category Growth', 'Market Localization']
  },
  {
    step: '05',
    stage: 'Optimizing',
    subtitle: 'Data & Performance',
    desc: 'Using strategy, data, and insights to make smarter decisions and maximize performance.',
    icon: 'imgFileDollar.svg',
    signals: ['Data Intelligence', 'Conversion Audits', 'Unit Economics']
  }
];

const experienceAreas = [
  {
    title: 'Brand & Marketing',
    image: 'https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=800&q=80',
    tags: ['Brand Development', 'Positioning', 'Product Launches', 'Marketing Strategy']
  },
  {
    title: 'Strategy & Growth',
    image: 'https://images.unsplash.com/photo-1531482615713-2afd69097998?auto=format&fit=crop&w=800&q=80',
    tags: ['Business Strategy', 'Market Expansion', 'Competitive Analysis', 'Go-to-Market']
  },
  {
    title: 'Business Development',
    image: 'https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=800&q=80',

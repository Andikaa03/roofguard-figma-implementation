  ['“The data analytics and audience insights uncovered revenue opportunities we had completely overlooked. Truly strategic thinking with practical rigor.”', 'Julian Thorne', 'Chief Strategy Officer', 'Berlin, DE', '11 May 2026', 'imgFrame1707482492.png'],
  ['“From repositioning our core offering to training our leadership on the new narrative, KOUNS was instrumental to our growth trajectory.”', 'Charlotte Dubois', 'Head of Marketing', 'Paris, FR', '29 Jun 2026', 'imgFrame1707482493.png'],
  ['“A rare advisory team that understands both high-level brand positioning and granular commercial metrics. Their perspective is unmatched.”', 'David K. Miller', 'Partner, Growth Equity', 'Edinburgh, UK', '15 Jul 2026', 'imgFrame1707482494.png'],
  ['“Clear thinking, fast execution, and zero unnecessary fluff. KOUNS is the growth advisory modern leadership actually needs.”', 'Amara Patel', 'Chief Commercial Officer', 'Dubai, UAE', '08 Aug 2026', 'imgFrame1707482495.png'],
];

const faqs = [
  ['What makes KOUNS different from traditional consultancies or agencies?', 'We bridge the gap between high-level management consulting and creative brand execution. We don’t deliver passive slide decks — we build practical, interconnected frameworks combining Brand, Strategy, BD, and Data.'],
  ['How do the four disciplines work together on an engagement?', 'Rather than working in silos, we analyze your challenge through all four lenses simultaneously: data reveals the opportunity, strategy gives direction, brand creates relevance, and business development builds commercial momentum.'],
  ['What size or stage of businesses do you typically partner with?', 'We partner with ambitious scale-ups, established mid-market enterprises, and corporate innovators seeking to reposition, enter new markets, or unlock their next stage of growth.'],
  ['What does a typical advisory engagement look like?', 'Engagements typically follow our 4-step framework (Discover, Define, Build, Grow), ranging from focused strategic sprints (4–6 weeks) to ongoing strategic advisory and growth partnerships.'],
  ['How quickly can we start and see actionable outcomes?', 'We can typically kick off within two weeks of initial alignment. Our Discover & Define phase delivers high-priority strategic signals and clarity within the first few weeks.'],
];

const articles = [
  ['Turning Data Into Direction: Why Insight Trumps Volume', 'Strategy & Data', '15 Aug 2026', 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=800&q=80'],
  ['The Interconnected Growth Model: Brand Meets Commercial Velocity', 'Growth Advisory', '28 Jul 2026', 'https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=800&q=80'],
  ['Strategic Positioning in Volatile Markets: Lessons From 50+ Engagements', 'Market Strategy', '10 Jul 2026', 'https://images.unsplash.com/photo-1542744173-8e7e53415bb0?auto=format&fit=crop&w=800&q=80'],
];
---

<Layout
  title="KOUNS — Strategy that creates growth"
  description="KOUNS — Strategy that creates growth. Branding, Strategy, Business Development, and Data & Insights for ambitious businesses."
  isHome={true}
>
  <main id="top">
    <!-- Hero Section -->
    <section class="hero-section">
          <div class="page-width hero-center-container">
            <!-- 1. Top Rating Pill -->
            <div class="rating-container" data-reveal>
              <span class="rating-icon-pill">Strategic Impact</span>
              <div class="rating-stars-wrap">
                <img class="rating-stars" src={asset('imgRatingStars.svg')} alt="5 stars" />
                <span class="rating-score">5.0 / 5.0</span>
              </div>
              <span class="rating-count">• 50+ Engagements</span>
            </div>

            <!-- 2. Main Centered Title -->
            <h1 class="hero-title" data-reveal>
              Strategy that creates <span class="text-highlight">growth<span class="dot-accent">.</span></span>
            </h1>

            <!-- 3. Centered Lede Copy -->
            <p class="hero-lede" data-reveal>
              We help ambitious businesses build stronger brands, make smarter strategic decisions, unlock new opportunities, and turn data into sustainable growth.
            </p>

            <!-- 4. Centered Actions -->
            <div class="hero-cta-wrapper" data-reveal>
              <a href="#contact" class="button button-accent button-large hero-call">
                <img src={asset('imgCalling02.svg')} alt="" />
                <span>Let’s Talk</span>
              </a>
            </div>

            <!-- 5. 3D Rotating Hero Visual Carousel Component -->
            <div data-reveal="scale" style="width: 100%; display: flex; justify-content: center;">
              <Hero3DCarousel />
            </div>
          </div>

          <!-- Marquee Ticker -->
          <div class="marquee-wrapper" aria-label="KOUNS Core Disciplines">
            <div class="marquee-track">
              <div class="marquee-item"><img src={asset('imgArrowUpRight03.svg')} alt="" /><span>Sustainable Growth</span></div>
              <div class="marquee-item"><img src={asset('imgTags.svg')} alt="" /><span>Brand</span></div>
              <div class="marquee-item"><img src={asset('imgSecurityCheck.svg')} alt="" /><span>Strategy</span></div>
              <div class="marquee-item"><img src={asset('imgWork1.svg')} alt="" /><span>Business Development</span></div>
              <div class="marquee-item"><img src={asset('imgFileDollar.svg')} alt="" /><span>Data &amp; Insights</span></div>
              <div class="marquee-item"><img src={asset('imgImpact.svg')} alt="" /><span>Turn Insight Into Impact</span></div>
              <!-- Duplicate track for gapless infinite scroll -->
              <div class="marquee-item"><img src={asset('imgArrowUpRight03.svg')} alt="" /><span>Sustainable Growth</span></div>
              <div class="marquee-item"><img src={asset('imgTags.svg')} alt="" /><span>Brand</span></div>
              <div class="marquee-item"><img src={asset('imgSecurityCheck.svg')} alt="" /><span>Strategy</span></div>
              <div class="marquee-item"><img src={asset('imgWork1.svg')} alt="" /><span>Business Development</span></div>
              <div class="marquee-item"><img src={asset('imgFileDollar.svg')} alt="" /><span>Data &amp; Insights</span></div>
              <div class="marquee-item"><img src={asset('imgImpact.svg')} alt="" /><span>Turn Insight Into Impact</span></div>
            </div>
          </div>
        </section>

        <!-- 01 — The Challenge Section -->
        <section class="challenge-section" id="challenge">
          <div class="page-width">
            <div class="challenge-header" data-reveal>
              <div class="section-tag">
                <span class="tag-dot"></span>
                <span>The Challenge</span>
              </div>
              <div class="challenge-title-row">
                <h2>Growth starts with clarity.</h2>
                <p class="challenge-lead">
                  Every business reaches defining moments where the next move isn't obvious. We help leadership teams cut through ambiguity, identify high-leverage opportunities, and build sustainable momentum.
                </p>
              </div>
            </div>

            <div class="challenge-content-grid">
              <!-- Left Column: The 4 Strategic Inflection Points -->
              <div class="challenge-moments" data-reveal="left">
                <span class="moments-label">Defining moments where we partner with leaders:</span>
                <div class="moments-list" data-reveal-stagger>
                  <div class="moment-item">
                    <div class="moment-icon"><img src={asset('imgTags.svg')} alt="" /></div>
                    <div class="moment-text">
                      <h4>Brand Relevance &amp; Identity</h4>
                      <p>A brand may need to evolve to stay relevant, compelling, and clearly differentiated in shifting competitive markets.</p>
                    </div>
                  </div>

                  <div class="moment-item">
                    <div class="moment-icon"><img src={asset('imgArrowUpRight03.svg')} alt="" /></div>
                    <div class="moment-text">
                      <h4>Untapped Market Opportunities</h4>
                      <p>A high-value customer segment or commercial channel is waiting to be unlocked with the right go-to-market strategy.</p>
                    </div>
                  </div>

                  <div class="moment-item">
                    <div class="moment-icon"><img src={asset('imgSecurityCheck.svg')} alt="" /></div>
                    <div class="moment-text">
                      <h4>Strategic Focus &amp; Realignment</h4>
                      <p>A sprawling strategy needs to become sharply focused on the core levers that drive sustainable enterprise value.</p>
                    </div>
                  </div>

                  <div class="moment-item">
                    <div class="moment-icon"><img src={asset('imgFileDollar.svg')} alt="" /></div>
                    <div class="moment-text">
                      <h4>Data &amp; Intelligence Utilization</h4>
                      <p>The business possesses rich operational data but lacks actionable intelligence to make high-conviction decisions.</p>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Right Column: Visual + Agency Mission & Quote -->
              <div class="challenge-card-side" data-reveal="right">
                <div class="challenge-photo-card">
                  <img src={kouns('challenge-meeting.jpg')} alt="Strategic Executive Alignment" class="challenge-photo" />
                  <div class="challenge-photo-tag">
                    <img src={asset('imgAppleReminder.svg')} alt="" />
                    <span>Executive Alignment &amp; Direction</span>
                  </div>
                </div>

                <div class="challenge-quote-card">
                  <div class="quote-mark">“</div>
                  <blockquote>
                    Because growth isn't just about doing more. It's about knowing what to do next.
                  </blockquote>
                  <p class="quote-support">
                    We help leaders make sense of complexity, identify what matters most, and turn strategic opportunities into tangible commercial action.
                  </p>
                  <a href="#contact" class="button button-accent button-large challenge-cta">
                    <img src={asset('imgService.svg')} alt="" />
                    <span>Start a Conversation</span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- 02 — What We Do Section (Four Disciplines) -->
        <section class="services-section" id="disciplines">
          <div class="page-width services-inner">
            <div class="section-heading-row" data-reveal>
              <div>
                <h2>Four disciplines.<br />One growth perspective.</h2>
                <p class="section-summary">
                  We bring together brand, strategy, business development and data to help businesses move forward with greater clarity and confidence.
                </p>
              </div>
              <a href="#contact" class="button button-accent button-large">
                <img src={asset('imgArrowRight01.svg')} alt="" />
                <span>Work With Us</span>
              </a>
            </div>

            <div class="disciplines-grid" data-reveal-stagger>
              {disciplines.map((d) => (
                <article class="discipline-card">
                  <div class="discipline-image">
                    <img src={d.image} alt={d.title} />
                  </div>
                  <span class="discipline-badge">{d.badge}</span>
                  <h3>{d.title}</h3>
                  <p style="font-weight: 600; color: var(--ink); font-size: 14.5px; margin-bottom: 6px;">{d.pitch}</p>
                  <p class="discipline-pitch">{d.desc}</p>
                  <ul class="discipline-list">
                    {d.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </article>
              ))}
            </div>
          </div>
        </section>

        <!-- 03 — Our Approach Section (Integrated Growth Architecture) -->
        <section class="approach-section" id="approach">
          <div class="page-width">
            <div class="approach-header" data-reveal>
              <div class="section-tag">
                <span class="tag-dot"></span>
                <span>Integrated Growth Architecture</span>
              </div>
              <div class="approach-title-row">
                <div>
                  <h2>We connect the dots.</h2>
                  <div class="discipline-chips">
                    <span class="discipline-chip">Brand</span>
                    <span class="chip-divider">•</span>
                    <span class="discipline-chip">Strategy</span>
                    <span class="chip-divider">•</span>
                    <span class="discipline-chip">Business Development</span>
                    <span class="chip-divider">•</span>
                    <span class="discipline-chip">Data</span>
                  </div>
                </div>
                <p class="approach-lead">
                  Too often, these disciplines operate independently. We believe the strongest growth strategies happen when they work together as a unified system.
                </p>
              </div>
            </div>

            <div class="approach-grid">
              <!-- Left Column: The 5 Integrated Principles -->
              <div class="approach-pillars-list" data-reveal-stagger>
                {approachPoints.map((point) => (
                  <div class="approach-pillar-card">
                    <div class="pillar-icon-box">
                      <img src={asset(point.icon)} alt="" />
                    </div>
                    <div class="pillar-body">
                      <div class="pillar-meta">
                        <span class="pillar-discipline">{point.discipline}</span>
                        <span class="pillar-step">Pillar {point.step}</span>
                      </div>
                      <h3 class="pillar-title">{point.title}</h3>
                      <p class="pillar-desc">{point.text}</p>
                    </div>
                  </div>
                ))}
              </div>

              <!-- Right Column: Visual Frame + Synergy Callout Card -->
              <div class="approach-visual-column" data-reveal="right">
                <div class="approach-photo-frame">
                  <img src={kouns('approach-team.jpg')} alt="KOUNS Strategic Growth Collaboration" class="approach-photo" />
                  <div class="approach-photo-overlay">
                    <div class="overlay-badge">
                      <img src={asset('imgService.svg')} alt="" />
                      <span>Cross-Discipline Alignment</span>
                    </div>
                    <h4>KOUNS Strategic Growth Collaboration</h4>
                    <p>Where senior expertise across all 4 growth verticals convenes to build compounding momentum.</p>
                  </div>
                </div>

                <div class="synergy-callout-card">
                  <div class="synergy-top">
                    <div class="synergy-icon">
                      <img src={asset('imgImpact.svg')} alt="" />
                    </div>
                    <div>
                      <span class="synergy-label">The Compound Growth Multiplier</span>
                      <h3>Why integrated disciplines win.</h3>
                    </div>
                  </div>
                  <p class="synergy-desc">
                    Isolated marketing fails without market strategy; data is meaningless without commercial agility. When brand, strategic clarity, partnership development, and analytics converge, growth becomes predictable, defensible, and sustainable.
                  </p>
                  <div class="synergy-pills">
                    <span class="synergy-pill">✓ Zero Silos</span>
                    <span class="synergy-pill">✓ Unified Roadmaps</span>
                    <span class="synergy-pill">✓ Compounding Enterprise Value</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- 04 — How We Work Section -->
        <section class="before-after-section" id="work">
          <div class="page-width before-after-inner">
            <div class="center-heading" data-reveal>
              <div class="section-tag">
                <span class="tag-dot"></span>
                <span>How We Work</span>
              </div>
              <h2>From complexity to clarity.</h2>
              <p>Our approach is designed to be collaborative, practical and focused on tangible outcomes.</p>
            </div>
            <div class="steps-grid" data-reveal-stagger>
              {processSteps.map((step) => (
                <div class="step-card">
                  <div class="step-num">{step.num}</div>
                  <h3 class="step-title">{step.title}</h3>
                  <p class="step-desc">{step.desc}</p>
                  <div class="step-quote">{step.quote}</div>
                </div>
              ))}
            </div>
          </div>
        </section>

        <!-- 05 — Who We Work With Section (Client Growth Horizons) -->
        <section class="stages-section" id="who">
          <div class="page-width">
            <div class="stages-header" data-reveal>
              <div class="section-tag">
                <span class="tag-dot"></span>
                <span>Client Growth Horizons</span>
              </div>
              <h2>For businesses ready for what’s next.</h2>
              <p class="stages-lede">
                We work with ambitious organizations, leadership teams and entrepreneurs who want to challenge the status quo and create their next stage of growth.
              </p>
            </div>

            <div class="stages-grid" data-reveal-stagger>
              {whoWeWorkWith.map((w) => (
                <div class="stage-card">
                  <div class="stage-card-top">
                    <span class="stage-step">Stage {w.step}</span>
                    <div class="stage-icon-wrap">
                      <img src={asset(w.icon)} alt="" />
                    </div>
                  </div>
                  <h3 class="stage-title">{w.stage}</h3>
                  <span class="stage-subtitle">{w.subtitle}</span>
                  <p class="stage-desc">{w.desc}</p>
                  <div class="stage-signals">
                    {w.signals.map((sig) => (
                      <span class="stage-signal-pill">{sig}</span>
                    ))}
                  </div>
                </div>
              ))}
            </div>

            <!-- Strategic Stage Diagnostic Callout -->
            <div class="stage-diagnostic-banner" data-reveal>
              <div class="diagnostic-content">
                <div class="diagnostic-badge">
                  <img src={asset('imgAppleReminder.svg')} alt="" />
                  <span>Strategic Assessment</span>
                </div>
                <h3>Where does your business sit on this growth spectrum?</h3>
                <p>
                  Whether establishing your core market positioning or optimizing complex revenue streams, we structure our advisory sprints around your specific stage.
                </p>
              </div>
              <div class="diagnostic-action">
                <a href="#contact" class="button button-accent button-large">
                  <span>Explore Growth Sprint</span>
                  <img src={asset('imgArrowUpRight03.svg')} alt="" />
                </a>
              </div>
            </div>
          </div>
        </section>

        <!-- 06 & 07 — Why Us & Selected Areas of Experience -->
        <section class="projects-section" id="experience">
          <div class="page-width projects-inner">
            <div class="projects-heading" data-reveal>
              <h2>Experience that travels.</h2>
              <p class="section-summary" style="margin-top: 12px;">
                Our experience spans brands, markets, products, commercial strategies and growth challenges across diverse industries and business environments.
              </p>
            </div>

            <div class="experience-grid" data-reveal-stagger>
              {experienceAreas.map((exp) => (
                <article class="experience-card">
                  <div class="experience-image">
                    <img src={exp.image} alt={exp.title} />
                  </div>
                  <div class="experience-content">
                    <h3>{exp.title}</h3>
                    <p style="font-size: 14px; color: var(--muted); margin-bottom: 8px;">Key Competencies &amp; Focus:</p>
                    <div class="experience-tags">
                      {exp.tags.map((t) => (
                        <span class="experience-tag">{t}</span>
                      ))}
                    </div>
                  </div>
                </article>
              ))}
            </div>

            <div class="experience-cta-card" data-reveal>
              <div class="experience-quote-wrap">
                <div class="quote-symbol" aria-hidden="true">“</div>
                <div class="quote-text-group">
                  <blockquote class="experience-quote-text">
                    Different challenges. Different markets. One constant: finding a better way forward.
                  </blockquote>
                  <p class="experience-quote-sub">
                    Tailored strategic advisory sprints &amp; ongoing growth partnerships.
                  </p>
                </div>
              </div>
              <a href="#contact" class="button button-accent button-large experience-action-btn">
                <span>Discuss Your Challenge</span>
                <img src={asset('imgArrowUpRightDark.svg')} alt="" />
              </a>
            </div>
          </div>
        </section>

        <!-- 08 — About Section -->
        <section class="about-section" id="about">
          <div class="page-width about-layout">
            <div class="about-top-row" data-reveal>
              <div class="about-statement">
                Built at the intersection of <span class="about-highlight">strategy, creativity, commercial vision, and growth.</span>
              </div>
              <a href="#contact" class="button button-accent button-large about-button">
                <span>Meet the Founder</span>
                <img src={asset('imgArrowUpRight03.svg')} alt="" />
              </a>
            </div>

            <div class="about-stats-grid" id="aboutStatsGrid" data-reveal-stagger>
              <div class="about-stat-item">
                <strong data-counter="4" data-suffix="+"><span class="counter-num">0</span><span class="counter-suffix">+</span></strong>
                <span>Core Disciplines</span>
              </div>
              <div class="about-stat-item">
                <strong data-counter="15" data-suffix="+"><span class="counter-num">0</span><span class="counter-suffix">+</span></strong>
                <span>Years Advisory Experience</span>
              </div>
              <div class="about-stat-item">
                <strong data-counter="50" data-suffix="+"><span class="counter-num">0</span><span class="counter-suffix">+</span></strong>
                <span>Growth Projects Delivered</span>
              </div>
              <div class="about-stat-item">
                <strong data-counter="100" data-suffix="%"><span class="counter-num">0</span><span class="counter-suffix">%</span></strong>
                <span>Strategic Outcome Focus</span>
              </div>
            </div>
          </div>
        </section>

        <!-- Testimonials Section -->
        <section class="testimonials-section" id="reviews">
          <div class="page-width testimonials-inner">
            <div class="center-heading" data-reveal>
              <h2>What leaders say</h2>
              <p class="section-summary">Perspectives from executives, founders, and partners who trust KOUNS</p>
            </div>
            <div class="testimonial-marquee-wrapper" data-reveal="scale">
              <!-- Row 1: Moving to the Left -->
              <div class="testimonial-track-row track-left">
                <div class="testimonial-track-inner">
                  {testimonials.slice(0, 4).map(([quote, name, role, location, date, avatar]) => (
                    <TestimonialCard quote={quote} name={name} role={role} location={location} date={date} avatar={avatar} />
                  ))}
                </div>
                <div class="testimonial-track-inner" aria-hidden="true">
                  {testimonials.slice(0, 4).map(([quote, name, role, location, date, avatar]) => (
                    <TestimonialCard quote={quote} name={name} role={role} location={location} date={date} avatar={avatar} />
                  ))}
                </div>
              </div>

              <!-- Row 2: Moving to the Right -->
              <div class="testimonial-track-row track-right">
                <div class="testimonial-track-inner">
                  {testimonials.slice(4, 8).map(([quote, name, role, location, date, avatar]) => (
                    <TestimonialCard quote={quote} name={name} role={role} location={location} date={date} avatar={avatar} />
                  ))}
                </div>
                <div class="testimonial-track-inner" aria-hidden="true">
                  {testimonials.slice(4, 8).map(([quote, name, role, location, date, avatar]) => (
                    <TestimonialCard quote={quote} name={name} role={role} location={location} date={date} avatar={avatar} />
                  ))}
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- 09 — Final CTA & Contact Strip -->
        <section class="contact-strip" id="contact">
          <div class="contact-inner" data-reveal>
            <div class="contact-label">
              <img src={asset('imgCustomerSupport.svg')} alt="" />
              Ready to build what’s next? Let’s start with a conversation.
            </div>
            <a href="mailto:hello@kouns.agency" class="contact-email">
              hello@kouns.agency
            </a>
            <div class="contact-scroll-track" id="contactScrollTrack" aria-label="Strategic Growth Progression">
              <span class="scroll-word">Let’s talk</span>
              <span class="scroll-sep">•</span>
              <span class="scroll-word">Let’s align</span>
              <span class="scroll-sep">•</span>
              <span class="scroll-word">Let’s build</span>
              <span class="scroll-sep">•</span>
              <span class="scroll-word">Let’s scale</span>
              <span class="scroll-sep">•</span>
              <span class="scroll-word">Let’s transform</span>
            </div>
          </div>
        </section>

        <!-- FAQ Section -->
        <section class="faq-section">
          <div class="page-width faq-inner" data-reveal>
            <div class="center-heading">
              <h2>Frequently asked questions</h2>
              <p>Everything you need to know about partnering with KOUNS.</p>
            </div>
            <div class="faq-list">
              {faqs.map(([question, answer], index) => (
                <details>
                  <summary>
                    <span class="faq-question-text"><span class="faq-num">0{index + 1}.</span> {question}</span>
                    <span class="faq-icon-circle" aria-hidden="true">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                      </svg>
                    </span>
                  </summary>
                  <div class="faq-content">
                    <p>{answer}</p>
                  </div>
                </details>
              ))}
            </div>
            <div class="faq-cta">
              <div>
                <h3>Ready to discuss your next stage?</h3>
                <p>Reach out to schedule an introductory strategy dialogue.</p>
              </div>
              <a href="#contact" class="button button-accent button-large">
                <img src={asset('imgCalling02.svg')} alt="" />
                <span>Start a Conversation</span>
              </a>
            </div>
          </div>
        </section>

        <!-- Blog / Perspectives Section -->
        <section class="blog-section" id="blog">
          <div class="page-width blog-inner">
            <div class="section-heading-row" data-reveal>
              <div>
                <h2>Perspectives &amp; Insights</h2>
                <p class="section-summary">Strategic frameworks and analysis on brand, commercial execution, and market intelligence.</p>
              </div>
              <a href="#contact" class="button button-accent button-large">
                <img src={asset('imgArrowRight01.svg')} alt="" />
                <span>Explore All</span>
              </a>
            </div>
            <div class="blog-grid" data-reveal-stagger>
              {articles.map(([title, category, date, image]) => (
                <article class="blog-card">
                  <div class="blog-meta">
                    <span><img src={asset('imgTags.svg')} alt="" />{category}</span>
                    <span><img src={asset('imgCalendar03.svg')} alt="" />{date}</span>
                  </div>
                  <img src={image} alt={title} />
                  <div class="blog-title">
                    <h3>{title}</h3>
                    <img src={asset('imgGroup41.svg')} alt="" />
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
  </main>
</Layout>

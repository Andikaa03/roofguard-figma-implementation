  ['“Their ability to synthesize complex market intelligence into actionable commercial priorities made all the difference. An invaluable strategic partner.”', 'Elena Rostova', 'Managing Director', 'Zurich, CH', '02 Feb 2026', 'imgFrame1707482489.png'],
  ['“Working with KOUNS connected our brand positioning directly to our business development channels. We unlocked three major enterprise partnerships in six months.”', 'Marcus Chen', 'VP Business Development', 'Singapore', '18 Mar 2026', 'imgFrame1707482490.png'],

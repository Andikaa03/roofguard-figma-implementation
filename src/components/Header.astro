---
interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
const kouns = (path: string) => `/assets/kouns/${path}`;
const asset = (path: string) => `/assets/roofguard/${path}`;
const prefix = isHome ? '' : '/';
---

<!-- Info Bar -->
<div class="info-bar">
  <div class="info-items page-width">
    <div class="info-items-track">
      <span><img src={asset('imgWork.svg')} alt="" />15+ Years Strategic Advisory</span>
      <span><img src={asset('imgSecurityCheck.svg')} alt="" />Branding • Strategy • Business Development • Data</span>
      <span><img src={asset('imgAppleReminder.svg')} alt="" />Outcome-Driven Growth Frameworks</span>
      <span><img src={asset('imgTimer02.svg')} alt="" />Global Advisory Practice</span>
      <span aria-hidden="true"><img src={asset('imgWork.svg')} alt="" />15+ Years Strategic Advisory</span>
      <span aria-hidden="true"><img src={asset('imgSecurityCheck.svg')} alt="" />Branding • Strategy • Business Development • Data</span>
      <span aria-hidden="true"><img src={asset('imgAppleReminder.svg')} alt="" />Outcome-Driven Growth Frameworks</span>
      <span aria-hidden="true"><img src={asset('imgTimer02.svg')} alt="" />Global Advisory Practice</span>
    </div>
  </div>
</div>

<!-- Site Header -->
<header class="site-header">
  <div class="page-width nav-row">
    <a class="brand-lockup" href={isHome ? '#top' : '/'} aria-label="KOUNS Home">
      <img src={kouns('logo-header-dark.png')} alt="KOUNS" class="brand-header-logo" />
    </a>
    <nav class="site-nav" aria-label="Primary navigation">
      <a href={`${prefix}#disciplines`}>Services</a>
      <a href={`${prefix}#about`}>About</a>
      <a href={`${prefix}#contact`}>Contact</a>
    </nav>
    <a class="button button-accent button-header" href={`${prefix}#contact`}>
      <span>Let’s Talk</span>
      <img src={asset('imgArrowRight01.svg')} alt="" aria-hidden="true" />
    </a>
  </div>
</header>
